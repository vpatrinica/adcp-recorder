{
  "Name": "ADCPRecorder",
  "DisplayName": "ADCP Recorder Service",
  "Description": "NMEA Telemetry Recorder for Nortek ADCP Instruments",
  "ExecutablePath": "C:\\s1000\\src\\adcp-recorder\\.venv\\Scripts\\python.exe",
  "StartupDirectory": "C:\\s1000\\src\\adcp-recorder",
  "Parameters": "-m adcp_recorder.service.supervisor",
  "StartupType": 2,
  "Priority": 2,
  "StdoutPath": "C:\\s1000\\data\\logs\\stdout.log",
  "StderrPath": "C:\\s1000\\data\\logs\\stderr.log",
  "EnableRotation": false,
  "RotationSize": 10,
  "EnableDateRotation": true,
  "DateRotationType": 0,
  "MaxRotations": 30,
  "EnableHealthMonitoring": true,
  "HeartbeatInterval": 30,
  "MaxFailedChecks": 3,
  "RecoveryAction": 1,
  "MaxRestartAttempts": 5,
  "EnvironmentVariables": "PROGRAMDATA=C:\\\\ProgramData",
  "RunAsLocalSystem": true,
  "PreLaunchTimeoutSeconds": 30,
  "PreLaunchRetryAttempts": 0,
  "PreLaunchIgnoreFailure": false,
  "EnableDebugLogs": false,
  "StartTimeout": 10,
  "StopTimeout": 10
}